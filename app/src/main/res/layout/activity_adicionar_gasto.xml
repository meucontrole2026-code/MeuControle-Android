<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true">

    <!-- Header Royal Blue -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_blue"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adicionar gasto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registre seu novo lançamento"
            android:textSize="12sp"
            android:textColor="#E2E8F0"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor"
            android:textSize="12sp"
            android:textColor="#CBD5E1"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/txtValorDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 0,00"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Descrição Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descrição"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/inputDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ex: Mercado, Uber, Farmácia..."
                        android:textSize="15sp"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:background="@android:color/transparent"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingBottom="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Categoria Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Categoria"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginBottom="12dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <TextView android:id="@+id/catAlimentacao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="🍔 Alimentação" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/catMoradia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="🏠 Moradia" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/catTransporte" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="🚗 Transporte" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/catSaude" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="💊 Saúde" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/catLazer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="🎮 Lazer" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/catCompras" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="🛍️ Compras" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/catEducacao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="📚 Educação" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/catContas" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="💡 Contas" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/catOutros" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="📦 Outros" android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" android:background="@drawable/bg_chip_selector" android:padding="12dp" android:layout_margin="4dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>

                    </GridLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Data e Pagamento -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <!-- Data Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:id="@+id/layoutData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅 Data"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/txtDataSelecionada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09/09/2026"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1E293B" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pagamento Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginStart="8dp">

                    <LinearLayout
                        android:id="@+id/layoutPagamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💳 Pagamento"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/txtPagamentoSelecionado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Débito ▼"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1E293B" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Teclado Numérico -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="20dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn1" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="1" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn2" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="2" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn3" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="3" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn4" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="4" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn5" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="5" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn6" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="6" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn7" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="7" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn8" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="8" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn9" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="9" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDot" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="." android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn0" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E293B" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="⌫" android:textSize="20sp" android:textStyle="bold" android:textColor="#EF4444" app:backgroundTint="#F8F9FA" app:cornerRadius="12dp"/>

                </GridLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botão Adicionar Gasto -->
            <Button
                android:id="@+id/btnSalvarGasto"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Adicionar gasto"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="#1E63F5"
                app:cornerRadius="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>