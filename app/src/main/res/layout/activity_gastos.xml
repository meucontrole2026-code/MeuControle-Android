<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA">

    <!-- Conteúdo Principal Scrollável -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="75dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Azul com Resumo e Filtros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E63F5"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meus Gastos"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtResumoCabecalho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extrato Completo · Total: R$ 0,00"
                    android:textSize="13sp"
                    android:textColor="#E2E8F0"
                    android:layout_marginBottom="16dp" />

                <!-- Filtros em Horizontal Scroll para todas as 9 categorias -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/filtroTodas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Todas"
                            android:textColor="#1E63F5"
                            android:textStyle="bold"
                            android:background="@drawable/bg_circle_white"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/filtroAlimentacao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alimentação"
                            android:textColor="@android:color/white"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/filtroTransporte"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transporte"
                            android:textColor="@android:color/white"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/filtroLazer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lazer"
                            android:textColor="@android:color/white"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/filtroSaude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saúde"
                            android:textColor="@android:color/white"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/filtroEducacao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Educação"
                            android:textColor="@android:color/white"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/filtroMoradia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Moradia"
                            android:textColor="@android:color/white"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/filtroVestuario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vestuário"
                            android:textColor="@android:color/white"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/filtroOutros"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Outros"
                            android:textColor="@android:color/white"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:gravity="center" />

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Título Lançamentos Recentes -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LANÇAMENTOS RECENTES"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="8dp" />

                <!-- RecyclerView do Extrato -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewGastosFiltro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Barra de Navegação Inferior Fixa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:gravity="center_vertical">

        <!-- 1. Início -->
        <LinearLayout
            android:id="@+id/btnMenuInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Início" android:textSize="10sp" android:textColor="#64748B"/>
        </LinearLayout>

        <!-- 2. Gastos (Ativo nesta tela) -->
        <LinearLayout
            android:id="@+id/btnMenuGastos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gastos" android:textSize="10sp" android:textColor="#1E63F5" android:textStyle="bold"/>
        </LinearLayout>

        <!-- 3. Novo (+) com Destaque Circular Azul -->
        <LinearLayout
            android:id="@+id/btnMenuAdicionar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_circle_blue"
                android:elevation="4dp"
                android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="+" android:textSize="24sp" android:textStyle="bold" android:textColor="@android:color/white" android:gravity="center"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Novo" android:textSize="10sp" android:textColor="#1E63F5" android:textStyle="bold"/>
        </LinearLayout>

        <!-- 4. Análises -->
        <LinearLayout
            android:id="@+id/btnMenuAnalises"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Análises" android:textSize="10sp" android:textColor="#64748B"/>
        </LinearLayout>

        <!-- 5. Perfil -->
        <LinearLayout
            android:id="@+id/btnMenuPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perfil" android:textSize="10sp" android:textColor="#64748B"/>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>