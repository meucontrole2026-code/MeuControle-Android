<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Botão Voltar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnVoltarLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Voltar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E63F5"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Ícone / Logo Circular Azul -->
        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_circle_blue"
            android:layout_marginBottom="20dp"
            android:elevation="4dp"
            android:gravity="center">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="📝"
                android:textSize="32sp"
                android:gravity="center"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar Nova Conta"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preencha os dados para começar a gerir"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="28dp" />

        <!-- Nome Completo -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#1E63F5"
            app:hintTextColor="#1E63F5"
            app:boxBackgroundColor="@android:color/white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome completo"
                android:inputType="textPersonName"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:textColorHint="#475569" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- E-mail -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#1E63F5"
            app:hintTextColor="#1E63F5"
            app:boxBackgroundColor="@android:color/white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmailCadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:textColorHint="#475569" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Senha com o Olho Interativo (passwordToggleEnabled) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#1E63F5"
            app:hintTextColor="#1E63F5"
            app:boxBackgroundColor="@android:color/white"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputSenhaCadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Palavra-passe"
                android:inputType="textPassword"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:textColorHint="#475569" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Requisitos detalhados da senha -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A senha deve conter: mín. de 6 caracteres, 1 letra maiúscula, 1 número e 1 caractere especial (@#$%^&amp;+=)."
            android:textSize="11sp"
            android:textColor="#64748B"
            android:layout_marginBottom="24dp"
            android:paddingStart="4dp" />

        <!-- Botão Registar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Registar Conta"
                android:backgroundTint="#1E63F5"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <ProgressBar
                android:id="@+id/progressBarCadastro"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Aceite dos Termos de Uso -->
        <CheckBox
            android:id="@+id/checkTermos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Li e concordo com os Termos de Uso e Política de Privacidade"
            android:textSize="12sp"
            android:textColor="#334155"
            android:layout_marginBottom="16dp" />

        <!-- Voltar para o Login -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já tem uma conta? "
                android:textSize="13sp"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/txtIrParaLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faça login"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1E63F5" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>