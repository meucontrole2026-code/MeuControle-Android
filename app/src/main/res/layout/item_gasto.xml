<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:layout_marginBottom="6dp">

    <!-- Emoji / Ícone da Categoria -->
    <TextView
        android:id="@+id/txtIconeEmoji"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textSize="22sp"
        android:text="🛍️"
        android:layout_marginEnd="12dp"
        android:background="@drawable/circle_background" />

    <!-- Descrição, Categoria e Data/Hora -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição do Gasto"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCategoriaTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoria"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#3B82F6"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txtDataHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/09/2026 · 14:30"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPagamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pix"
            android:textSize="10sp"
            android:textColor="#94A3B8"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Valor do Gasto -->
    <TextView
        android:id="@+id/txtValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-R$ 0,00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#EF4444"
        android:layout_marginEnd="8dp" />

    <!-- 🗑️ Botão de Deletar -->
    <ImageView
        android:id="@+id/btnDeletar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Apagar Gasto"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:tint="#EF4444" />

</LinearLayout>
