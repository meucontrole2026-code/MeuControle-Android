<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="🔢"
            android:textSize="36sp"
            android:gravity="center"
            android:background="@drawable/fundo_card_amarelo"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digite o Código"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insira o código de 4 dígitos enviado para o seu e-mail"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="28dp"
            android:gravity="center" />

        <!-- Campo do Código -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#0F8A5F"
            app:hintTextColor="#0F8A5F"
            app:boxBackgroundColor="@android:color/white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Código de 4 dígitos"
                android:inputType="number"
                android:maxLength="4"
                android:textSize="18sp"
                android:textAlignment="center"
                android:textColor="#0F172A"
                android:textColorHint="#475569" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botão Confirmar -->
        <Button
            android:id="@+id/btnConfirmarCodigo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Validar Código"
            android:backgroundTint="#0F8A5F"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>